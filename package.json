{
  "name": "talking-pictures",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node scripts/clean.mjs dist",
    "build": "npm run clean && tsc -b && vite build",
    "analyze": "node scripts/clean.mjs dist-analyze && vite build --config vite.analyze.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "zip": "node scripts/zip.mjs",
    "release": "npm run build && node scripts/zip.mjs",
    "e2e": "node scripts/smoke.mjs",
    "voice": "node scripts/voice.mjs --batch=7 --model=gemini-2.5-flash-preview-tts",
    "voice:qa": "node scripts/voice-qa.mjs",
    "sfx": "node scripts/sfx.mjs",
    "promo": "node scripts/promo-texts.mjs && npm run build && node scripts/promo.mjs",
    "voice:csv": "node scripts/voice.mjs --csv",
    "sdk:proxy": "sdk-dev-proxy -p dist --dev-mode=true --port 8091",
    "sdk:check": "node scripts/sdk-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/pangolin": "^5.3.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^12.0.0",
    "howler": "^2.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@yandex-games/sdk-dev-proxy": "^0.0.2",
    "fflate": "^0.8.3",
    "mpg123-decoder": "^1.0.3",
    "playwright": "^1.50.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^4.0.0"
  }
}
